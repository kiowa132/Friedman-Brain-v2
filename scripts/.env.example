# Copy this file to `.env` (same folder) and paste your key(s) below.
# `.env` is gitignored — keys are never committed.

# OpenAI gpt-image-1 (recommended engine). Key: https://platform.openai.com/api-keys
# Needs a paid balance + a budget cap. ~$0.04/image at medium quality.
OPENAI_API_KEY=

# Google Gemini (optional). Key: https://aistudio.google.com/apikey
# Image generation needs billing enabled — the free tier is limit:0 for images.
GEMINI_API_KEY=
